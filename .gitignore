@'
# ==========================================
# PYTHON
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/

# ==========================================
# VIRTUAL ENVIRONMENTS
# ==========================================
venv/
.venv/
env/
ENV/
.python-version

# ==========================================
# DATASETS - LIDC-IDRI / CANCER DATA
# ==========================================
data/
datasets/
raw_data/
processed_data/
external_data/

*.dcm
*.nii
*.nii.gz
*.npy
*.npz
*.hdf5
*.h5
*.parquet

# ==========================================
